{
    "name": "@one-am/react-native-simple-image-slider",
    "version": "1.0.0",
    "source": "src",
    "description": "A simple and performant image slider made with FlashList. Includes a full screen gallery component with gesture support.",
    "main": "./lib/commonjs/index.js",
    "module": "./lib/module/index.js",
    "types": "./lib/typescript/commonjs/src/index.d.ts",
    "exports": {
        ".": {
            "react-native": {
                "types": "./lib/typescript/module/src/index.d.ts",
                "default": "./lib/module/index.js"
            },
            "module": {
                "types": "./lib/typescript/module/src/index.d.ts",
                "default": "./lib/module/index.js"
            },
            "module-sync": {
                "types": "./lib/typescript/module/src/index.d.ts",
                "default": "./lib/module/index.js"
            },
            "default": {
                "types": "./lib/typescript/commonjs/src/index.d.ts",
                "default": "./lib/commonjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "example": "yarn workspace @one-am/react-native-simple-image-slider-example",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "lint": "eslint \"**/*.{js,ts,tsx}\"",
        "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "clean": "del-cli lib",
        "prepare": "lefthook install && bob build",
        "release": "release-it",
        "sync:deps": "node bin/sync-peer-to-dev.js"
    },
    "keywords": [
        "react-native",
        "image-slider",
        "gallery"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/one-am-it/react-native-simple-image-slider.git"
    },
    "author": "one-am <info@oneam.it> (https://github.com/one-am-it)",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/one-am-it/react-native-simple-image-slider/issues"
    },
    "homepage": "https://github.com/one-am-it/react-native-simple-image-slider#readme",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "dependencies": {
        "merge-refs": "^1.2.2"
    },
    "peerDependencies": {
        "@shopify/flash-list": ">=2",
        "expo-haptics": "*",
        "expo-image": "*",
        "expo-status-bar": "*",
        "react": ">=19",
        "react-native": ">=0.83",
        "react-native-gesture-handler": "*",
        "react-native-reanimated": ">=4",
        "react-native-safe-area-context": "*",
        "react-native-svg": "*",
        "react-native-worklets": "*"
    },
    "devDependencies": {
        "@babel/runtime": "^7.28.4",
        "@commitlint/config-conventional": "^20.2.0",
        "@evilmartians/lefthook": "^2.0.12",
        "@react-native/babel-preset": "^0.83.0",
        "@react-native/eslint-config": "^0.83.0",
        "@react-native/jest-preset": "0.85.3",
        "@release-it/conventional-changelog": "^10.0.4",
        "@shopify/flash-list": "2.0.2",
        "@testing-library/react-native": "^14.0.0",
        "@types/jest": "^30.0.0",
        "@types/react": "^19.2.7",
        "@typescript-eslint/eslint-plugin": "^8.50.0",
        "@typescript-eslint/parser": "^8.50.0",
        "babel-plugin-module-resolver": "^5.0.2",
        "commitlint": "^20.2.0",
        "del-cli": "^7.0.0",
        "eslint": "^9.39.1",
        "eslint-config-expo": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "expo-haptics": "~56.0.3",
        "expo-image": "~56.0.11",
        "expo-status-bar": "~56.0.4",
        "expo-system-ui": "~56.0.5",
        "jest": "^29.7.0",
        "prettier": "^3.4.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.85.3",
        "react-native-builder-bob": "^0.40.15",
        "react-native-gesture-handler": "~2.31.1",
        "react-native-reanimated": "4.3.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-svg": "15.15.4",
        "react-native-web": "^0.21.0",
        "react-native-worklets": "0.8.3",
        "react-test-renderer": "^19.2.7",
        "release-it": "^19.1.0",
        "test-renderer": "^1.2.0",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.46.4",
        "typescript-plugin-styled-components": "^3.0.0"
    },
    "resolutions": {
        "conventional-changelog-conventionalcommits": "8.0.0"
    },
    "workspaces": [
        "example"
    ],
    "packageManager": "yarn@3.6.1",
    "jest": {
        "preset": "@react-native/jest-preset",
        "modulePathIgnorePatterns": [
            "<rootDir>/example/node_modules",
            "<rootDir>/lib/"
        ]
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            [
                "module",
                {
                    "esm": true
                }
            ],
            [
                "commonjs",
                {
                    "esm": true
                }
            ],
            [
                "typescript",
                {
                    "project": "tsconfig.build.json"
                }
            ]
        ]
    }
}
